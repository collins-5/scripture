{
  "expo": {
    "name": "Scripture",
    "slug": "scripture-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mobileapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scripture.mobileapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d9488"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.scripture.mobileapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0d9488"
        }
      ],
      "expo-secure-store"
    ]
  }
}
